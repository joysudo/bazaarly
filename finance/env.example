PORT=3001

# From your profile page on the Nessie site (log in with GitHub). Keep it server-side only.
NESSIE_API_KEY=your-nessie-api-key
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
# Optional: skip the merchant lookup by naming one
# NESSIE_MERCHANT_ID=

# Optional: ignore sales created before this moment (ISO date), e.g. to skip test sales from earlier
# SYNC_SINCE=2026-10-10T23:00:00Z
# Optional: Jake
# VENDOR_ID=demo

# Firebase service account key (Project settings > Service accounts > Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ---------- Sales advice chat (POST /api/advice) ----------
# Which model answers: snowflake | anthropic | mock   (mock needs no keys, good for demos and testing)
LLM_PROVIDER=mock

# Snowflake Cortex REST. ACCOUNT_URL is your Snowsight account URL, e.g. https://myorg-myaccount.snowflakecomputing.com
# PAT: Snowsight > your user > Settings > Authentication > Programmatic access tokens
# SNOWFLAKE_ACCOUNT_URL=
# SNOWFLAKE_PAT=
# SNOWFLAKE_MODEL=llama3.1-70b

# Anthropic fallback
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
